<Window x:Class="Factorio_Calculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Factorio_Calculator"
        Title="Factorio Calculator"
        Height="550"
        Width="800"
        MinHeight="450"
        MinWidth="650"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:IconPathConverter x:Key="IconPathConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Редактор рецепта"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            
            <DockPanel Margin="0,0,0,5">
                <Button Content="Выбрать рецепт"
            DockPanel.Dock="Right"
            Width="140"
            Height="28"
            Click="OpenRecipeCatalog_Click"/>

                <TextBlock Text="Название рецепта"
               VerticalAlignment="Center"/>
            </DockPanel>

            <TextBox x:Name="RecipeNameTextBox"
         Height="30"
         Margin="0,0,0,12"/>

            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Время производства (сек.)"/>
                    <TextBox x:Name="CraftTimeTextBox"
                             Text="1"
                             Height="30"
                             Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="Количество продукта за цикл"/>
                    <TextBox x:Name="OutputAmountTextBox"
                             Text="1"
                             Height="30"
                             Margin="0,5,0,0"/>
                </StackPanel>
            </UniformGrid>
        </StackPanel>



        <GroupBox Grid.Row="2"
          Header="Производственная машина"
          Padding="10"
          Margin="0,0,0,20">

            <StackPanel>
                <TextBlock Text="Выберите завод"
                   Margin="0,0,0,8"/>

                <ListBox x:Name="FactoryListBox"
                 Height="66"
                 BorderThickness="0"
                 Background="Transparent"
                 SelectionMode="Single"
                 SelectionChanged="FactoryListBox_SelectionChanged">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Width" Value="56"/>
                            <Setter Property="Height" Value="56"/>
                            <Setter Property="Margin" Value="0,0,6,0"/>
                            <Setter Property="Padding" Value="3"/>
                            <Setter Property="ToolTip" Value="{Binding Name}"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                        Background="#303030"
                                        BorderBrush="#555555"
                                        BorderThickness="2"
                                        CornerRadius="3"
                                        Padding="{TemplateBinding Padding}">

                                            <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder"
                                                Property="BorderBrush"
                                                Value="#E9B44C"/>
                                                <Setter TargetName="ItemBorder"
                                                Property="Background"
                                                Value="#575038"/>
                                            </Trigger>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder"
                                                Property="BorderBrush"
                                                Value="#C9C9C9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding IconPath}"
                           Width="44"
                           Height="44"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="FactoryNameTextBlock"
                   FontWeight="Bold"
                   Margin="0,8,0,0"/>

                <TextBlock x:Name="FactorySpeedTextBlock"
                   Margin="0,5,0,0"/>

                <TextBlock x:Name="FactoryModulesTextBlock"
                   Margin="0,5,0,0"/>

                <TextBlock Text="Установленные модули"
           FontWeight="Bold"
           Margin="0,12,0,6"/>

                <ItemsControl x:Name="ModuleSlotsItemsControl">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="48"
                    Height="48"
                    Margin="0,0,6,0"
                    Padding="2"
                    Tag="{Binding}"
                    ToolTip="Выбрать или заменить модуль"
                    Click="ModuleSlot_Click">

                                <Grid Background="#303030">

                                    <TextBlock Text="+"
                               FontSize="22"
                               Foreground="#AAAAAA"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">

                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding InstalledModule}"
                                                 Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Image Source="{Binding InstalledModule.IconPath, Converter={StaticResource IconPathConverter}}"
                           Width="42"
                           Height="42"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>


            </StackPanel>
        </GroupBox>



        <GroupBox Grid.Row="3"
                  Header="Ингредиенты"
                  Padding="10">

            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">

                    <Button Content="Добавить"
                            Width="100"
                            Height="30"
                            Margin="0,0,10,0"
                            Click="AddIngredient_Click"/>

                    <Button Content="Удалить"
                            Width="100"
                            Height="30"
                            Click="RemoveIngredient_Click"/>
                </StackPanel>

                <DataGrid x:Name="IngredientsDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Single">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название"
                                            Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Количество"
                                            Binding="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                            Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>


        <GroupBox Grid.Row="4"
          Header="Расчёт производства"
          Padding="10"
          Margin="0,15,0,0">

            <StackPanel>
                <TextBlock Text="Необходимо продуктов в секунду"
                   Margin="0,0,0,5"/>

                <TextBox x:Name="RequiredProductionTextBox"
                 Text="10"
                 Height="30"
                 Margin="0,0,0,10"/>

                <Button Content="Рассчитать производство"
                Height="35"
                Click="CalculateProduction_Click"/>

                <TextBlock x:Name="ProductionResultTextBlock"
                   Margin="0,10,0,10"
                   TextWrapping="Wrap"/>

                <DataGrid x:Name="ConsumptionDataGrid"
                  Height="120"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ингредиент"
                                    Binding="{Binding Name}"
                                    Width="*"/>

                        <DataGridTextColumn Header="Требуется / сек."
                                    Binding="{Binding RequiredPerSecond, StringFormat={}{0:N2}}"
                                    Width="160"/>

                        <DataGridTextColumn Header="Максимум / сек."
                                    Binding="{Binding MaximumPerSecond, StringFormat={}{0:N2}}"
                                    Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </GroupBox>

        <Button Grid.Row="5"
                Content="Проверить рецепт"
                Height="38"
                Margin="0,20,0,0"
                Click="CheckRecipe_Click"/>
    </Grid>
</Window>
